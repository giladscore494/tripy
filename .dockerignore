# Keep the image small and free of local state or secrets.
.git
.github
.env
.env.*
!.env.example
runs/
.tripy-data/
.tripy-data-*/
data_local/
**/__pycache__
**/*.pyc
.pytest_cache
.mypy_cache
.venv
venv
*.log
tests/
# the frontend is built inside the image from package-lock.json (npm ci); never a local install or build
frontend/node_modules
frontend/dist
frontend/*.tsbuildinfo
