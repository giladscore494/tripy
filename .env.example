# TRIPY environment variables.
# Local: cp .env.example .env, fill the REQUIRED values, then `set -a; . ./.env; set +a; streamlit run app.py`.
# Railway: set the same names under the service's Variables tab (never commit real values).
# Empty values mean "use the built-in default". Placeholders below are NOT real credentials.

# =====================================================================================================
# REQUIRED
# =====================================================================================================
# Z.ai / GLM API key (secret). Read from the environment only; production never asks for it in the UI.
GLM_API_KEY=
# Research model id, sent unchanged as the API "model" for every research/tool turn.
GLM_MODEL=glm-5.3-flash

# =====================================================================================================
# DEPLOYMENT (Railway)
# =====================================================================================================
# Root of all durable state (runs, run state, checkpoints, document cache, research memory).
# Railway: mount a Volume at /data and set TRIPY_DATA_DIR=/data. Local default: <repo>/.tripy-data
TRIPY_DATA_DIR=
# "production" hides the development-only API-key box and other dev conveniences (the Dockerfile sets it).
TRIPY_ENV=
# Required in production — private dashboard access secret (secret; never commit it). Without it a production
# dashboard refuses to open. Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
TRIPY_ACCESS_TOKEN=
# Railway injects PORT automatically; scripts/start.sh binds 0.0.0.0:$PORT (8501 when unset). Do not set it there.
# PORT=8501

# =====================================================================================================
# OPTIONAL
# =====================================================================================================
# Model id for the compact finalization call only. Empty = GLM_MODEL. e.g. GLM_FINALIZER_MODEL=glm-5.3
GLM_FINALIZER_MODEL=
# glm (GLM web_search API, uses GLM_API_KEY) | duckduckgo (keyless HTML search)
SEARCH_BACKEND=glm
# Postgres URL (secret) of a role that can SELECT public.catalog_variants_current and EXECUTE
# public.catalog_variant_equipment. Without it the frozen Level 1.5 snapshot in data/ is used.
DATABASE_URL=
# Alias accepted for DATABASE_URL.
SUPABASE_DB_URL=
# Market the research targets.
TARGET_MARKET=IL
# How many research runs may execute at the same time in this server (default 1; provider limits are shared).
TRIPY_MAX_ACTIVE_RUNS=1
# Seconds active runs get to persist an interrupted result when the server stops (keep below Railway's draining time).
TRIPY_SHUTDOWN_GRACE_S=20
# Allow typing an API key in the UI (default: allowed in development, refused in production).
TRIPY_ALLOW_UI_API_KEY=
# Server log level (stdout): DEBUG | INFO | WARNING | ERROR
TRIPY_LOG_LEVEL=INFO

# =====================================================================================================
# ADVANCED TUNING (defaults are the tested configuration; change deliberately)
# =====================================================================================================
# --- GLM endpoints (defaults follow the official Z.ai docs) ---
GLM_BASE_URL=https://api.z.ai/api/paas/v4
# Chat completions endpoint (POST): path relative to GLM_BASE_URL, or a full URL.
GLM_CHAT_PATH=chat/completions
# Standalone web search endpoint (POST): path relative to GLM_BASE_URL, or a full URL.
GLM_SEARCH_PATH=web_search
GLM_SEARCH_ENGINE=search-prime
# Reasoning effort (top-level `reasoning_effort` request field): low | medium | high | max; empty = each phase's own
# GLM_<PHASE>_REASONING_EFFORT, else the code defaults research high, document sweep / recovery / finalizer low.
GLM_REASONING_EFFORT=
# Thinking: empty = provider default (nothing sent) or "enabled" -> {"thinking": {"type": "enabled"}}. glm-5.3 models
# always think and reject "disabled" (HTTP 400, code 1210): a configured "disabled" is never sent; it maps to no
# thinking object + reasoning effort low (unless an effort is set explicitly).
GLM_THINKING=
# Optional JSON object merged into every chat request, e.g. {"custom_flag": true}. A thinking object of type
# "disabled" in it is stripped (same mapping as GLM_THINKING=disabled).
GLM_EXTRA_BODY=

# --- Attempts and timeouts (TOTAL HTTP attempts per request; 1 = no retry) ---
GLM_CHAT_MAX_ATTEMPTS=2
GLM_SEARCH_MAX_ATTEMPTS=3
# Read timeout per attempt, seconds (applies to chat and search requests).
GLM_CHAT_TIMEOUT_S=240

# --- Cost reporting. Empty = built-in official defaults:
#   glm-5.3 $1.40/$4.40, glm-5.3-flash $0.15/$0.50, glm-5.3-flashx $0.37/$1.25 per 1M in/out tokens,
#   web search $0.01 per call.
GLM_PRICE_INPUT_PER_MTOK=
GLM_PRICE_OUTPUT_PER_MTOK=
GLM_PRICE_WEB_SEARCH_PER_CALL=

# --- Primary research (source acquisition) ---
# Turn ceiling (UI range 3-80). AGENT_MAX_STEPS is the legacy alias.
PRIMARY_RESEARCH_MAX_TURNS=6
# AGENT_MAX_STEPS=6
# Stop after N consecutive turns that acquire nothing new. 0 = off.
PRIMARY_RESEARCH_NO_ARTIFACT_STOP=2
# contract (default): primary research = source acquisition only (search / fetch tools, acquisition prompt, progress =
# new documents / candidates, an under-acquired extension ends once it stops acquiring, always finalized from the
# bundle). legacy: the previous behaviour exactly (benchmark baseline arm).
ACQUISITION_MODE=contract
# Contract research only (default off): fetch_url / fetch_pdf results carry a server-computed `document_card`
# (variant match, market, authority, usability, in-scope candidate fields per source category; never evidence).
# on | off. These are DEFAULTS: a named run profile in the UI ignores them (see the UI's "Run profile").
ACQUISITION_DOCUMENT_CARD=off
# Optional acquisition-sufficiency transition (0 = off): >= N useful documents AND >= X% fields with a candidate.
PRIMARY_RESEARCH_MIN_USEFUL_DOCUMENTS=0
PRIMARY_RESEARCH_CANDIDATE_FIELD_COVERAGE_THRESHOLD=0
# Fail-safe minimum acquisition base and the hard ceiling an under-acquired run may extend to.
PRIMARY_RESEARCH_MIN_BASE_DOCUMENTS=3
PRIMARY_RESEARCH_MIN_BASE_SCOPED_COVERAGE=50
PRIMARY_RESEARCH_HARD_MAX_TURNS=12
# Finalize after N consecutive turns with no new research artifact. 0 = off.
AGENT_NO_NEW_RESEARCH_TURNS=2
# Context limits.
AGENT_MAX_TOOL_OUTPUT_CHARS=6000
AGENT_KEEP_RECENT_TOOL_RESULTS=4
AGENT_COMPACT_TOOL_OUTPUT_CHARS=700
AGENT_FINALIZER_BUNDLE_MAX_CHARS=60000
# Level 3 open research (reliability, costs, resale, recalls) is opt-in.
INCLUDE_LEVEL3=false

# --- Requested enrichment fields ---
# Empty = every field in data/enrichment_fields.json. Comma list of names or a JSON list of names/specs.
ENRICHMENT_FIELDS=
# Alternative schema / rule files (same shape as the files in data/).
ENRICHMENT_SCHEMA_PATH=
IDENTITY_VOCABULARY_PATH=
SOURCE_RULES_PATH=

# --- Deterministic harvest + local-first document sweep ---
LAYERED_HARVEST_ENABLED=true
# adjudication (default): the model only judges pre-checked candidates in small no-tool JSON packets per recovery
# cluster (U = unambiguous, A = ambiguous, M = label snippets only); the DOCUMENT_SWEEP_MAX_PACKET_CHARS / _MAX_FIELDS /
# _MAX_CANDIDATES chunk limits below do not apply to it. legacy: the tool-loop sweep those limits shape.
SWEEP_MODE=adjudication
ADJUDICATION_MAX_U_ITEMS=40
ADJUDICATION_MAX_A_FIELDS=6
ADJUDICATION_MAX_A_CANDIDATES=18
ADJUDICATION_MAX_M_FIELDS=6
ADJUDICATION_MAX_M_SNIPPETS=12
# max_tokens of one U / A / M call (reasoning effort and timeout follow the GLM_DOCUMENT_SWEEP_* phase settings)
ADJUDICATION_U_MAX_TOKENS=1500
ADJUDICATION_A_MAX_TOKENS=2000
ADJUDICATION_M_MAX_TOKENS=1500
# Both modes: 0 = no sweep. Legacy: a 2nd turn only after a turn-1 cached-document inspection returned content.
DOCUMENT_SWEEP_MAX_TURNS=2
DOCUMENT_SWEEP_MAX_PACKET_CHARS=28000
DOCUMENT_SWEEP_MAX_FIELDS=12
DOCUMENT_SWEEP_MAX_CANDIDATES=16
DOCUMENT_SWEEP_CANDIDATES_PER_FIELD=3

# --- Tail recovery ---
FIELD_RECOVERY_ENABLED=true
# reacquire (default: per cluster a targeted acquisition episode, harvest, grounded candidates, adjudication) |
# cluster (the tool-using cluster recovery agent) | legacy (per-field)
RECOVERY_MODE=reacquire
# importer site map for contract acquisition and re-acquisition (on | off)
SITE_MAP=on
# grounded candidates before adjudication for fields without an admissible candidate (on | off)
GROUNDED_CANDIDATES=on
CLUSTER_MAX_ATTEMPTS=2
CLUSTER_BASE_TURNS=2
CLUSTER_MAX_TURNS=4
CLUSTER_SEARCH_BUDGET=4
FIELD_RECOVERY_MAX_ATTEMPTS=2
FIELD_RECOVERY_MAX_STEPS=4
# Hard cap on recovery model turns per vehicle (0 = no cap).
FIELD_RECOVERY_MAX_TOTAL_STEPS=24
FIELD_RECOVERY_PRIOR_EXCERPTS_MAX_ITEMS=8
FIELD_RECOVERY_PRIOR_EXCERPTS_MAX_CHARS=8000
FIELD_RECOVERY_PRIOR_EXCERPT_MAX_CHARS=1500

# --- Final assembly ---
# deterministic (default): the final output values are assembled in code from the field states and admitted evidence;
# a model writes at most the summary / research trace. llm: the finalizer model writes the output (previous behaviour).
FINAL_ASSEMBLY=deterministic

# --- Cross-run research memory ---
RESEARCH_MEMORY_ENABLED=true
FACT_REUSE_MAX_AGE_DAYS=365
NEGATIVE_ROUTE_MAX_AGE_DAYS=30
NEGATIVE_ROUTE_BLOCKING=true

# --- Per-phase inference settings (empty = inherit the global setting) ---
# PHASE = RESEARCH | DOCUMENT_SWEEP | RECOVERY | FINALIZER: GLM_<PHASE>_REASONING_EFFORT (low|medium|high|max; empty
# = GLM_REASONING_EFFORT, else research high / others low), GLM_<PHASE>_THINKING (enabled; "disabled" is mapped as
# above), GLM_<PHASE>_MAX_TOKENS, GLM_<PHASE>_TEMPERATURE, GLM_<PHASE>_TIMEOUT_S, GLM_<PHASE>_MAX_ATTEMPTS (total HTTP
# attempts per chat request; empty = GLM_CHAT_MAX_ATTEMPTS, except DOCUMENT_SWEEP and RECOVERY whose default is 1: no
# identical retry of a large request after a timeout); GLM_DOCUMENT_SWEEP_MODEL, GLM_RECOVERY_MODEL.
GLM_RESEARCH_REASONING_EFFORT=
GLM_DOCUMENT_SWEEP_REASONING_EFFORT=
GLM_RECOVERY_REASONING_EFFORT=
GLM_FINALIZER_REASONING_EFFORT=
GLM_DOCUMENT_SWEEP_THINKING=
GLM_DOCUMENT_SWEEP_MAX_ATTEMPTS=1
GLM_RECOVERY_MAX_ATTEMPTS=1
GLM_RECOVERY_THINKING=
GLM_DOCUMENT_SWEEP_MODEL=
GLM_RECOVERY_MODEL=

# --- Concurrency (Z.ai limits are per account; the pools are shared by the whole process) ---
BATCH_MAX_WORKERS=50
# Operational in-flight chat requests for every known model (empty = defaults: glm-5.3-flash 48 of 50,
# glm-5.3-flashx 18 of 20, glm-5.3 5 of 5). Never above the provider limit.
GLM_CHAT_MAX_INFLIGHT=
# Per-model override, e.g. {"glm-5.3-flash": 50}
GLM_CHAT_MAX_INFLIGHT_BY_MODEL=
# Search-Prime in-flight requests (provider limit 5).
GLM_SEARCH_MAX_INFLIGHT=5
GLM_UNKNOWN_MODEL_MAX_INFLIGHT=1

# --- Tools ---
# Comma-separated tools never offered to the model.
DISABLED_TOOLS=
TOOL_PREVIEW_CHARS=1200
TOOL_MAX_TEXT_CHARS=4000
TOOL_MAX_LINKS=40
TOOL_MAX_TABLE_ROWS=40
TOOL_MAX_TABLES=8
# render_page needs Playwright (not installed in the Docker image; the tool is then left out automatically).
PLAYWRIGHT_CHROMIUM_EXECUTABLE=

# --- Legacy storage overrides (win over TRIPY_DATA_DIR when set) ---
# Keep using an existing ./runs folder: MILO_RUNS_DIR=runs (cache then defaults to runs/_cache).
MILO_RUNS_DIR=
MILO_CACHE_DIR=
