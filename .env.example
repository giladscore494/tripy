# --- GLM (required) ---
GLM_API_KEY=
# Research model id, sent unchanged as the API "model" for every research/tool turn.
GLM_MODEL=glm-5.3-flash
# Optional: model id for the compact finalization call only. Empty = GLM_MODEL.
# e.g. GLM_MODEL=glm-5.3-flash with GLM_FINALIZER_MODEL=glm-5.3
GLM_FINALIZER_MODEL=
# Defaults below match the official Z.ai docs; all are overridable.
GLM_BASE_URL=https://api.z.ai/api/paas/v4
# Chat completions endpoint (POST): path relative to GLM_BASE_URL, or a full URL.
GLM_CHAT_PATH=chat/completions
# Standalone web search endpoint (POST): path relative to GLM_BASE_URL, or a full URL.
GLM_SEARCH_PATH=web_search
# Engine name sent to the search endpoint.
GLM_SEARCH_ENGINE=search-prime
# Thinking: empty = provider default (nothing sent), "enabled" or "disabled" -> {"thinking": {"type": ...}}
GLM_THINKING=
# glm | duckduckgo
SEARCH_BACKEND=glm
# Optional JSON merged into every chat request, e.g. {"thinking": {"type": "enabled"}}
GLM_EXTRA_BODY=

# --- Attempts and timeouts (TOTAL HTTP attempts per request; 1 = no retry) ---
GLM_CHAT_MAX_ATTEMPTS=2
GLM_SEARCH_MAX_ATTEMPTS=3
# Read timeout per attempt, seconds (applies to chat and search requests).
GLM_CHAT_TIMEOUT_S=240

# --- Cost reporting. Leave empty to use the built-in official defaults:
#   glm-5.3 $1.40/$4.40, glm-5.3-flash $0.15/$0.50, glm-5.3-flashx $0.37/$1.25 per 1M in/out tokens,
#   web search $0.01 per call. Set a value to override it (applies to research and finalizer models).
GLM_PRICE_INPUT_PER_MTOK=
GLM_PRICE_OUTPUT_PER_MTOK=
GLM_PRICE_WEB_SEARCH_PER_CALL=

# --- Research budget and context limits ---
# Primary research is source acquisition: turn ceiling (alias AGENT_MAX_STEPS; UI range 3-80).
PRIMARY_RESEARCH_MAX_TURNS=6
# Stop primary research after N consecutive turns that acquire nothing new (new usable document, official source,
# candidate for an open field, admitted evidence, better binding). Re-reads / repeated searches / 403 don't count. 0 = off.
PRIMARY_RESEARCH_NO_ARTIFACT_STOP=2
# Optional acquisition-sufficiency transition (0 = off): >= N useful documents AND >= X% fields with a candidate.
PRIMARY_RESEARCH_MIN_USEFUL_DOCUMENTS=0
PRIMARY_RESEARCH_CANDIDATE_FIELD_COVERAGE_THRESHOLD=0
# Fail-safe: no early stop (and no stop at the normal ceiling) before >= N useful documents AND >= X% of the fields
# have a candidate from a source in their market scope; an under-acquired run may continue up to the hard ceiling.
PRIMARY_RESEARCH_MIN_BASE_DOCUMENTS=3
PRIMARY_RESEARCH_MIN_BASE_SCOPED_COVERAGE=50
PRIMARY_RESEARCH_HARD_MAX_TURNS=12
# Finalize after N consecutive turns with no new document / evidence / source / document query. 0 = off.
AGENT_NO_NEW_RESEARCH_TURNS=2
# Max chars of one tool result sent to the model; newest N results kept, older ones compacted to stubs.
AGENT_MAX_TOOL_OUTPUT_CHARS=6000
AGENT_KEEP_RECENT_TOOL_RESULTS=4
AGENT_COMPACT_TOOL_OUTPUT_CHARS=700
# Cap on the compact research bundle sent to the finalizer.
AGENT_FINALIZER_BUNDLE_MAX_CHARS=60000
# --- Requested enrichment fields and targeted field recovery ---
# Fields requested from the model. Empty = every field in data/enrichment_fields.json.
# Comma list of names (unknown names work too) or a JSON list of names/specs.
ENRICHMENT_FIELDS=
# Alternative schema file with the same shape as data/enrichment_fields.json.
ENRICHMENT_SCHEMA_PATH=
TARGET_MARKET=IL
# After primary research, every requested field without a usable candidate gets focused retries.
FIELD_RECOVERY_ENABLED=true
# Retry attempts per failed field (a field spec's "recovery_attempts" overrides this; 0 = never retry).
FIELD_RECOVERY_MAX_ATTEMPTS=2
# Model turns per retry attempt.
FIELD_RECOVERY_MAX_STEPS=4
# Hard cap on field-recovery model turns per vehicle, across all fields, attempts and turns.
# At the cap no further retry turn or attempt starts; the run still finalizes normally. 0 = no cap.
FIELD_RECOVERY_MAX_TOTAL_STEPS=24
# Bounded working memory handed to each retry: excerpts already exposed earlier in the run
# (not evidence). Items, total characters, characters per excerpt.
FIELD_RECOVERY_PRIOR_EXCERPTS_MAX_ITEMS=8
FIELD_RECOVERY_PRIOR_EXCERPTS_MAX_CHARS=8000
FIELD_RECOVERY_PRIOR_EXCERPT_MAX_CHARS=1500
# Breadth-first: every queued field gets attempt 1 before any field gets attempt 2.

# Level 3 open research (reliability, costs, resale, recalls) is opt-in for the Level 2 benchmark phase.
INCLUDE_LEVEL3=false

# --- Layered harvesting ---
# Deterministic candidates are harvested from every fetched document (0 model calls); then ONE bounded
# Model Document Sweep (cached-document tools only: 0 searches, 0 fetches) reviews them before web recovery.
LAYERED_HARVEST_ENABLED=true
# Document-sweep turns, adaptive: up to 2; the 2nd turn happens ONLY when turn 1 inspected cached documents
# and got content to read (a sweep that just promotes candidates stops after 1). 1 = never a 2nd turn; 0 = off.
DOCUMENT_SWEEP_MAX_TURNS=2
# Adaptive sweep: ONE call while the packet fits these limits, else deterministic chunks by recovery_cluster (0 = no
# limit). Candidates per field in the packet (storage keeps all).
DOCUMENT_SWEEP_MAX_PACKET_CHARS=28000
DOCUMENT_SWEEP_MAX_FIELDS=30
DOCUMENT_SWEEP_MAX_CANDIDATES=48
DOCUMENT_SWEEP_CANDIDATES_PER_FIELD=3

# --- Per-phase inference settings (empty = inherit the global setting) ---
# PHASE = RESEARCH | DOCUMENT_SWEEP | RECOVERY | FINALIZER: GLM_<PHASE>_THINKING (enabled|disabled),
# GLM_<PHASE>_MAX_TOKENS, GLM_<PHASE>_TEMPERATURE, GLM_<PHASE>_TIMEOUT_S; GLM_DOCUMENT_SWEEP_MODEL, GLM_RECOVERY_MODEL.
GLM_DOCUMENT_SWEEP_THINKING=
GLM_RECOVERY_THINKING=

# --- Concurrency (Z.ai account limits are per account; the pools are shared by the whole process) ---
# Vehicles researched at the same time in one batch (not a request limit).
BATCH_MAX_WORKERS=50
# Operational in-flight chat requests for every known model (empty = defaults: glm-5.3-flash 48 of 50,
# glm-5.3-flashx 18 of 20, glm-5.3 5 of 5). Never above the provider limit.
GLM_CHAT_MAX_INFLIGHT=
# Per-model override, e.g. {"glm-5.3-flash": 50}
GLM_CHAT_MAX_INFLIGHT_BY_MODEL=
# Search-Prime in-flight requests (provider limit 5).
GLM_SEARCH_MAX_INFLIGHT=5
# Any model id without a known provider limit.
GLM_UNKNOWN_MODEL_MAX_INFLIGHT=1

# Tool output caps (the full document always stays in the document cache).
TOOL_PREVIEW_CHARS=1200
TOOL_MAX_TEXT_CHARS=4000
TOOL_MAX_LINKS=40
TOOL_MAX_TABLE_ROWS=40
TOOL_MAX_TABLES=8

# --- Level 1.5 source (optional) ---
# Postgres URL of a role that can SELECT public.catalog_variants_current and EXECUTE
# public.catalog_variant_equipment. Without it the frozen snapshot in data/ is used.
DATABASE_URL=

# --- Local storage (optional) ---
MILO_RUNS_DIR=runs
# MILO_CACHE_DIR=runs/_cache
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=
