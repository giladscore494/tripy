# --- GLM (required) ---
GLM_API_KEY=
# Any GLM chat model id; can also be typed in the UI.
GLM_MODEL=
# Defaults below match the official Z.ai docs; all are overridable.
GLM_BASE_URL=https://api.z.ai/api/paas/v4
# Chat completions endpoint (POST): path relative to GLM_BASE_URL, or a full URL.
GLM_CHAT_PATH=chat/completions
# Standalone web search endpoint (POST): path relative to GLM_BASE_URL, or a full URL.
GLM_SEARCH_PATH=web_search
# Engine name sent to the search endpoint.
GLM_SEARCH_ENGINE=search-prime
# Thinking: empty = provider default (nothing sent), "enabled" or "disabled" -> {"thinking": {"type": ...}}
GLM_THINKING=
# glm | duckduckgo
SEARCH_BACKEND=glm
# Optional JSON merged into every chat request, e.g. {"thinking": {"type": "enabled"}}
GLM_EXTRA_BODY=
# Cost reporting. Leave empty to use the built-in official defaults:
#   glm-5.3 $1.40/$4.40, glm-5.3-flash $0.15/$0.50, glm-5.3-flashx $0.37/$1.25 per 1M in/out tokens,
#   web search $0.01 per call. Set a value to override it.
GLM_PRICE_INPUT_PER_MTOK=
GLM_PRICE_OUTPUT_PER_MTOK=
GLM_PRICE_WEB_SEARCH_PER_CALL=
AGENT_MAX_STEPS=30

# --- Level 1.5 source (optional) ---
# Postgres URL of a role that can SELECT public.catalog_variants_current and EXECUTE
# public.catalog_variant_equipment. Without it the frozen snapshot in data/ is used.
DATABASE_URL=

# --- Local storage (optional) ---
MILO_RUNS_DIR=runs
# MILO_CACHE_DIR=runs/_cache
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=
