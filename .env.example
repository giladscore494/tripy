# --- GLM (required) ---
GLM_API_KEY=
# Research model id, sent unchanged as the API "model" for every research/tool turn.
GLM_MODEL=glm-5.3-flash
# Optional: model id for the compact finalization call only. Empty = GLM_MODEL.
# e.g. GLM_MODEL=glm-5.3-flash with GLM_FINALIZER_MODEL=glm-5.3
GLM_FINALIZER_MODEL=
# Defaults below match the official Z.ai docs; all are overridable.
GLM_BASE_URL=https://api.z.ai/api/paas/v4
# Chat completions endpoint (POST): path relative to GLM_BASE_URL, or a full URL.
GLM_CHAT_PATH=chat/completions
# Standalone web search endpoint (POST): path relative to GLM_BASE_URL, or a full URL.
GLM_SEARCH_PATH=web_search
# Engine name sent to the search endpoint.
GLM_SEARCH_ENGINE=search-prime
# Thinking: empty = provider default (nothing sent), "enabled" or "disabled" -> {"thinking": {"type": ...}}
GLM_THINKING=
# glm | duckduckgo
SEARCH_BACKEND=glm
# Optional JSON merged into every chat request, e.g. {"thinking": {"type": "enabled"}}
GLM_EXTRA_BODY=

# --- Attempts and timeouts (TOTAL HTTP attempts per request; 1 = no retry) ---
GLM_CHAT_MAX_ATTEMPTS=2
GLM_SEARCH_MAX_ATTEMPTS=3
# Read timeout per attempt, seconds (applies to chat and search requests).
GLM_CHAT_TIMEOUT_S=240

# --- Cost reporting. Leave empty to use the built-in official defaults:
#   glm-5.3 $1.40/$4.40, glm-5.3-flash $0.15/$0.50, glm-5.3-flashx $0.37/$1.25 per 1M in/out tokens,
#   web search $0.01 per call. Set a value to override it (applies to research and finalizer models).
GLM_PRICE_INPUT_PER_MTOK=
GLM_PRICE_OUTPUT_PER_MTOK=
GLM_PRICE_WEB_SEARCH_PER_CALL=

# --- Research budget and context limits ---
# Soft research budget in model turns; then a compact finalization runs (UI range 3-80).
AGENT_MAX_STEPS=12
# Finalize after N consecutive turns with no new document / evidence / source / document query. 0 = off.
AGENT_NO_NEW_RESEARCH_TURNS=2
# Max chars of one tool result sent to the model; newest N results kept, older ones compacted to stubs.
AGENT_MAX_TOOL_OUTPUT_CHARS=6000
AGENT_KEEP_RECENT_TOOL_RESULTS=4
AGENT_COMPACT_TOOL_OUTPUT_CHARS=700
# Cap on the compact research bundle sent to the finalizer.
AGENT_FINALIZER_BUNDLE_MAX_CHARS=60000
# --- Requested enrichment fields and targeted field recovery ---
# Fields requested from the model. Empty = every field in data/enrichment_fields.json.
# Comma list of names (unknown names work too) or a JSON list of names/specs.
ENRICHMENT_FIELDS=
# Alternative schema file with the same shape as data/enrichment_fields.json.
ENRICHMENT_SCHEMA_PATH=
TARGET_MARKET=IL
# After primary research, every requested field without a usable candidate gets focused retries.
FIELD_RECOVERY_ENABLED=true
# Retry attempts per failed field (a field spec's "recovery_attempts" overrides this; 0 = never retry).
FIELD_RECOVERY_MAX_ATTEMPTS=2
# Model turns per retry attempt.
FIELD_RECOVERY_MAX_STEPS=4
# Optional cap on retry turns for the whole vehicle (cost guard). 0 = no cap.
FIELD_RECOVERY_MAX_TOTAL_STEPS=0
# Tool output caps (the full document always stays in the document cache).
TOOL_PREVIEW_CHARS=1200
TOOL_MAX_TEXT_CHARS=4000
TOOL_MAX_LINKS=40
TOOL_MAX_TABLE_ROWS=40
TOOL_MAX_TABLES=8

# --- Level 1.5 source (optional) ---
# Postgres URL of a role that can SELECT public.catalog_variants_current and EXECUTE
# public.catalog_variant_equipment. Without it the frozen snapshot in data/ is used.
DATABASE_URL=

# --- Local storage (optional) ---
MILO_RUNS_DIR=runs
# MILO_CACHE_DIR=runs/_cache
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=
