# --- GLM (required) ---
GLM_API_KEY=
# Any GLM chat model id; can also be typed in the UI.
GLM_MODEL=
# Defaults below are unverified starting points; override them to match the current API docs.
# Base URL (Z.ai international default; bigmodel: https://open.bigmodel.cn/api/paas/v4)
GLM_BASE_URL=https://api.z.ai/api/paas/v4
# Chat completions endpoint: path relative to GLM_BASE_URL, or a full URL.
GLM_CHAT_PATH=chat/completions
# Web search endpoint: path relative to GLM_BASE_URL, or a full URL.
GLM_SEARCH_PATH=web_search
# Engine name sent to the search endpoint (e.g. search-prime, search_std, search_pro).
GLM_SEARCH_ENGINE=search-prime
# glm | duckduckgo
SEARCH_BACKEND=glm
# Optional JSON merged into every chat request, e.g. {"thinking": {"type": "enabled"}}
GLM_EXTRA_BODY=
# Optional, for the cost column (USD per 1M tokens). Leave 0 to show n/a.
GLM_PRICE_INPUT_PER_MTOK=0
GLM_PRICE_OUTPUT_PER_MTOK=0
AGENT_MAX_STEPS=30

# --- Level 1.5 source (optional) ---
# Postgres URL of a role that can SELECT public.catalog_variants_current and EXECUTE
# public.catalog_variant_equipment. Without it the frozen snapshot in data/ is used.
DATABASE_URL=

# --- Local storage (optional) ---
MILO_RUNS_DIR=runs
# MILO_CACHE_DIR=runs/_cache
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=
