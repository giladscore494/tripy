{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tripy/contracts/vehicle-facts/1",
  "title": "vehicle-facts/1",
  "version": "vehicle-facts/1.1",
  "description": "One merged, provenance-tagged record per exact variant (POST /api/facts/v1/vehicles). Only fields with a value appear: never a null, a placeholder or an 'unknown' entry. Government facts use yeda-rechev's level15.GOVERNMENT_FACT_FIELDS names and adas.<flag> for its 19 ADAS flags; open-data facts use the offer field names of data/open_datasets.json field_map. Deterministic: the same data and versions give byte-identical JSON (sorted keys). Minor 1.1 (additive): the government-dataset facts of data.gov.il (src/gov_data, the data/gov/ snapshots): original_new_price_ils, original_importer, recalls, recall_count, road_survival, each with source_level government_dataset, licence, attribution and resource_id; original_new_price_ils is the only fact that may carry {range, n_prices} instead of value.",
  "type": "object",
  "required": ["contract", "vehicles"],
  "properties": {
    "contract": {"const": "vehicle-facts/1"},
    "vehicles": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "record": {
      "oneOf": [
        {
          "type": "object",
          "required": ["variant_identity_key", "status", "identity", "facts", "open_data_match", "versions"],
          "properties": {
            "variant_identity_key": {"type": "string"},
            "status": {"const": "ok"},
            "identity": {"$ref": "#/$defs/identity"},
            "facts": {"type": "object", "properties": {"original_new_price_ils": {"$ref": "#/$defs/gov_price_fact"}, "original_importer": {"$ref": "#/$defs/gov_fact"}, "recalls": {"allOf": [{"$ref": "#/$defs/gov_fact"}, {"properties": {"value": {"type": "array", "items": {"$ref": "#/$defs/recall"}}}}]}, "recall_count": {"allOf": [{"$ref": "#/$defs/gov_fact"}, {"properties": {"value": {"type": "integer", "minimum": 0}}}]}, "road_survival": {"allOf": [{"$ref": "#/$defs/gov_fact"}, {"properties": {"value": {"$ref": "#/$defs/road_survival"}}}]}}, "additionalProperties": {"$ref": "#/$defs/fact"}},
            "open_data_match": {
              "type": "object",
              "properties": {
                "route": {"enum": ["european", "american", "unknown"]},
                "level": {"enum": ["model_family", "generation", "body_powertrain", "exact_technical_variant", "exact_market_trim"]},
                "designation": {"type": "string"}
              }
            },
            "versions": {"$ref": "#/$defs/versions"},
            "withheld": {"type": "array", "description": "Owner diagnostics only: ?debug=1 with the operator token, or the MCP facts_preview.", "items": {"type": "object", "required": ["source", "field", "reason"]}},
            "withheld_counts": {"type": "object", "additionalProperties": {"type": "integer"}}
          }
        },
        {
          "type": "object",
          "required": ["variant_identity_key", "status", "http_status"],
          "properties": {
            "variant_identity_key": {"type": "string"},
            "status": {"const": "not_found"},
            "http_status": {"const": 404},
            "versions": {"type": "object"}
          }
        }
      ]
    },
    "identity": {
      "type": "object",
      "properties": {
        "manufacturer": {"type": "string"}, "model": {"type": "string"}, "model_year": {"type": "integer"},
        "trim": {"type": "string"}, "degem_nm": {"type": "string"},
        "sug_tkina": {"enum": ["european", "american", "unknown"]},
        "body_style": {"type": "string"}, "fuel_type": {"type": "string"}, "propulsion": {"type": "string"},
        "drivetrain": {"type": "string"}, "engine_cc": {"type": "number"}, "horsepower": {"type": "number"},
        "automatic": {"type": "boolean"}, "upstream_record_id": {"type": "string"}
      }
    },
    "fact": {
      "type": "object",
      "required": ["value", "source", "source_level", "identity_level", "row_ids"],
      "properties": {
        "value": {"type": ["number", "string", "boolean"]},
        "unit": {"type": "string"},
        "standard": {"type": "string", "description": "WLTP / NEDC when the value belongs to a test cycle; absent otherwise"},
        "definition": {"type": "string", "description": "the open-data field definition (e.g. eu_running_order, na_curb)"},
        "source": {"enum": ["government", "eea_co2_cars", "epa_fueleconomy", "tc_cvs", "nrcan_fuel_ratings", "ademe_car_labelling"]},
        "source_level": {"enum": ["government", "open_data"]},
        "identity_level": {"enum": ["body_powertrain", "exact_technical_variant", "exact_market_trim"]},
        "basis": {"type": "string", "description": "government: variant_identity_key; open data: type_code_match+co2 | type_code_match | co2_match | unique | all_survivors_agree"},
        "row_ids": {"type": "array", "items": {"type": "string"}},
        "dataset_year": {"oneOf": [{"type": "integer"}, {"type": "array", "items": {"type": "integer"}}]},
        "attribution": {"type": "string"},
        "licence": {"type": "string"},
        "corroborated_by": {"type": "array", "items": {"type": "object", "required": ["source", "value"]}}
      }
    },
    "versions": {
      "type": "object",
      "required": ["contract", "admission", "zero_semantics", "snapshots_sha", "matcher", "gov_datasets"],
      "properties": {
        "contract": {"const": "vehicle-facts/1"}, "admission": {"type": "string"}, "zero_semantics": {"type": "string"},
        "snapshots_sha": {"type": "string"}, "matcher": {"type": "string"},
        "gov_datasets": {"type": "string", "description": "sha256 of data/gov/manifest.json (no_manifest before the first build)"},
        "gov_recall_model_map": {"type": "string", "description": "sha256 of data/gov/recall_model_map.json (no_map before the first build)"}
      }
    },
    "gov_fact": {"type": "object", "required": ["value", "source", "source_level", "licence", "attribution", "resource_id"], "properties": {"value": {}, "source": {"enum": ["gov_new_car_prices", "gov_recall_notices", "gov_road_survival"]}, "source_level": {"const": "government_dataset"}, "licence": {"type": "string", "description": "exactly as the data.gov.il package states it"}, "attribution": {"type": "string"}, "resource_id": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]}, "identity_level": {"enum": ["model", "model_year"]}, "basis": {"type": "string"}, "dataset_built_at": {"type": "string", "description": "the build date of the data/gov snapshot (YYYY-MM-DD)"}}, "not": {"anyOf": [{"required": ["range"]}, {"required": ["n_prices"]}]}},
    "gov_price_fact": {"type": "object", "description": "A new-car LIST price (מחיר מחירון חדש מקורי), never a transaction price. One distinct price for (tozeret_cd, degem_cd, shnat_yitzur): value; several (the list has no trim and no price date): only range + n_prices, never a value.", "required": ["source", "source_level", "licence", "attribution", "resource_id", "unit", "label_he"], "properties": {"value": {"type": "integer"}, "range": {"type": "array", "items": {"type": "integer"}, "minItems": 2, "maxItems": 2}, "n_prices": {"type": "integer", "minimum": 2}, "unit": {"const": "ILS"}, "label_he": {"const": "מחיר מחירון חדש מקורי"}, "price_type": {"const": "new_car_list_price"}, "source": {"enum": ["gov_new_car_prices", "gov_recall_notices", "gov_road_survival"]}, "source_level": {"const": "government_dataset"}, "licence": {"type": "string", "description": "exactly as the data.gov.il package states it"}, "attribution": {"type": "string"}, "resource_id": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]}, "identity_level": {"enum": ["model", "model_year"]}, "basis": {"type": "string"}, "dataset_built_at": {"type": "string", "description": "the build date of the data/gov snapshot (YYYY-MM-DD)"}}, "oneOf": [{"required": ["value"], "not": {"anyOf": [{"required": ["range"]}, {"required": ["n_prices"]}]}}, {"required": ["range", "n_prices"], "not": {"required": ["value"]}}]},
    "recall": {"type": "object", "required": ["recall_id"], "properties": {"recall_id": {"type": "string"}, "recall_year": {"type": "integer"}, "affected_system": {"type": "string"}, "fault_description": {"type": "string"}, "repair_method": {"type": "string"}, "production_range": {"type": "object", "properties": {"from": {"type": "string"}, "to": {"type": "string"}}}}},
    "road_survival": {"type": "object", "description": "Final cancellations of the cohort (active + finally cancelled vehicles of the same key; inactive-not-cancelled vehicles excluded). The reason for a cancellation is unknown (accident, total loss, export and failure are not distinguished): never a reliability measure.", "required": ["cohort_size", "cancelled_share_by_age", "definition_he"], "properties": {"cohort_size": {"type": "integer", "minimum": 200}, "cancelled_share_by_age": {"type": "object", "description": "age in years (3..20, only ages the whole cohort has reached) -> share of the cohort finally cancelled at that age or younger", "propertyNames": {"pattern": "^([3-9]|1[0-9]|20)$"}, "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}}, "median_age_at_final_cancellation": {"type": "number"}, "final_cancellation_rate": {"type": "number", "minimum": 0, "maximum": 1}, "definition_he": {"type": "string"}, "cohort_basis": {"enum": ["first_road_year", "shnat_yitzur"]}, "cohort_year": {"type": "integer"}, "model_year_share": {"type": "number"}, "reference_month": {"type": "string"}}}
  }
}
