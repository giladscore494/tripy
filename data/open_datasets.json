      "columns": {
        "make": {"source": ["Mk"], "required": true},
        "model": {"source": ["Cn"], "required": true},
        "type_approval": {"source": ["T"], "required": false},
        "variant": {"source": ["Va"], "required": false},
        "version": {"source": ["Ve"], "required": false},
        "fuel": {"source": ["Ft"], "required": true},
        "fuel_mode": {"source": ["Fm"], "required": false},
        "displacement_cc": {"source": ["Ec (cm3)"], "required": true, "unit": "cc"},
        "power_kw": {"source": ["Ep (KW)"], "required": true, "unit": "kW"},
        "co2_wltp": {"source": ["Ewltp (g/km)"], "required": false, "unit": "g/km"},
        "co2_nedc": {"source": ["Enedc (g/km)"], "required": false, "unit": "g/km"},
        "wheelbase_mm": {"source": ["W (mm)"], "required": false, "unit": "mm"},
        "track_front_mm": {"source": ["At1 (mm)"], "required": false, "unit": "mm"},
        "track_rear_mm": {"source": ["At2 (mm)"], "required": false, "unit": "mm"},
        "mass_running_order_kg": {"source": ["M (kg)"], "required": false, "unit": "kg", "definition": "eu_running_order"},
        "mass_wltp_test_kg": {"source": ["Mt"], "required": false, "unit": "kg", "definition": "eu_wltp_test_mass"},
        "energy_wh_km": {"source": ["Z (Wh/km)"], "required": false, "unit": "Wh/km"},
        "electric_range_km": {"source": ["Electric range (km)"], "required": false, "unit": "km",
                              "note": "not in the 2018 rows; the range column of another year's schema is added here only after it was read from that year's live schema"},
        "fuel_consumption_l_100km": {"source": ["Fc"], "required": false, "unit": "l/100km"},
        "year": {"source": ["Year"], "required": true}
      }
