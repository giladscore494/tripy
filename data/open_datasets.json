     "companion": {"electric_range_standard": "WLTP"},
     "routes": ["european"], "min_level": "exact_technical_variant", "portability_scope": "exact_technical_variant"},
    {"field": "gearbox_type", "source": "epa_fueleconomy", "column": "transmission", "transform": "gearbox_type", "definition": "gearbox",
