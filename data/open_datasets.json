    "nhtsa_vpic": {
      "policy_id": "nhtsa_vpic", "market": "US", "routes": ["american"], "identity_only": true,
      "label": "NHTSA vPIC VIN decode (identity keys only)",
      "source_url": "https://vpic.nhtsa.dot.gov/api/vehicles/DecodeVinValues/{vin}?format=json&modelyear={year}",
      "identity_keys": {"model": "Model", "engine_code": "EngineModel", "displacement_l": "DisplacementL",
                        "body": "BodyClass", "drive": "DriveType"}
    }
  },
  "wmi_by_make": {"קאדילאק": ["1G6"]},
  "vin_year_codes": {"2010": "A", "2011": "B", "2012": "C", "2013": "D", "2014": "E", "2015": "F", "2016": "G",
                     "2017": "H", "2018": "J", "2019": "K", "2020": "L", "2021": "M", "2022": "N", "2023": "P",
                     "2024": "R", "2025": "S", "2026": "T", "2027": "V"},
  "drive_values": {
    "two_wheel_drive": ["rear-wheel drive", "front-wheel drive", "2-wheel drive", "rwd", "fwd", "2wd", "4x2"],
    "awd": ["all-wheel drive", "4-wheel drive", "4-wheel or all-wheel drive", "part-time 4-wheel drive", "awd", "4wd", "4x4"]
  },
  "transmission_codes": {
    "_about": "EPA trany 'Automatic (S8)' / NRCan 'AS8': the class and the gear count (never guessed: a code that matches no pattern yields neither)",
    "patterns": [
      {"regex": "^automatic \\((?:s|a)?(\\d{1,2})\\)$", "class": "automatic", "gears": "$1", "gearbox_type": "automatic"},
      {"regex": "^automatic \\((?:am-s|am)(\\d{1,2})\\)$", "class": "automatic", "gears": "$1", "gearbox_type": null},
      {"regex": "^automatic \\((?:variable gear ratios|av|av-s\\d+)\\)$", "class": "automatic", "gears": null, "gearbox_type": "cvt"},
      {"regex": "^manual \\((?:m)?(\\d{1,2})\\)$", "class": "manual", "gears": "$1", "gearbox_type": "manual"},
      {"regex": "^(?:a|as)(\\d{1,2})$", "class": "automatic", "gears": "$1", "gearbox_type": "automatic"},
      {"regex": "^am(\\d{1,2})$", "class": "automatic", "gears": "$1", "gearbox_type": null},
      {"regex": "^av(?:s\\d+)?$", "class": "automatic", "gears": null, "gearbox_type": "cvt"},
      {"regex": "^m(\\d{1,2})$", "class": "manual", "gears": "$1", "gearbox_type": "manual"}
    ]  },
  "fuel_values": {
    "conventional": ["petrol", "diesel", "gasoline", "regular gasoline", "premium gasoline", "midgrade gasoline", "x", "z", "d", "essence", "gazole", "es", "go"],
    "battery_electric": ["electric", "electricity", "b", "el", "électrique"],
    "hybrid": ["petrol/electric", "diesel/electric", "hybrid", "eh", "gh"],
    "plug_in": ["petrol/electric", "diesel/electric", "plug-in hybrid", "ee", "gl"]
  },
  "fuel_mode_values": {"plug_in": ["P"], "hybrid": ["H"], "battery_electric": ["E"], "conventional": ["M", "B", "F"]},
  "body_values": {"sedan": ["sedan", "4dr sedan", "saloon"], "coupe": ["coupe", "2dr coupe"], "wagon": ["wagon", "estate"],
                  "suv": ["suv", "sport utility"], "hatchback": ["hatchback"], "convertible": ["convertible", "cabriolet"]},
  "field_map": [
    {"field": "wheelbase_mm", "source": "eea_co2_cars", "column": "wheelbase_mm", "unit": "mm", "definition": "wheelbase",
