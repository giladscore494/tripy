     "portability_scope": "exact_technical_variant"},
    {"field": "fuel_consumption_combined_l_100km", "source": "ademe_car_labelling", "column": "fuel_consumption_l_100km", "unit": "l/100km",
     "definition": "wltp_combined", "routes": ["european"], "min_level": "exact_technical_variant", "requires_key": "co2_wltp",
     "portability_scope": "exact_technical_variant"},
    {"field": "energy_consumption_kwh_100km", "source": "eea_co2_cars", "column": "energy_wh_km", "unit": "Wh/km", "scale": 0.1,
     "definition": "wltp_combined", "routes": ["european"], "min_level": "exact_technical_variant", "portability_scope": "exact_technical_variant"},
    {"field": "energy_consumption_kwh_100km", "source": "ademe_car_labelling", "column": "energy_wh_km", "unit": "Wh/km", "scale": 0.1,
