      "year_semantics": "model_year",
      "schema_verified": false,
      "columns": {
        "year": {"source": ["Model year", "MODEL YEAR", "Model Year"]},
        "make": {"source": ["Make", "MAKE"]},
        "model": {"source": ["Model", "MODEL"]},
        "vehicle_class": {"source": ["Vehicle class", "VEHICLE CLASS", "Vehicle Class"]},
