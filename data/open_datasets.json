    {"field": "gear_count", "source": "epa_fueleconomy", "column": "transmission", "transform": "gear_count", "definition": "gearbox",
     "routes": ["european", "american", "unknown"], "min_level": "exact_technical_variant", "portability_scope": "exact_technical_variant"},
    {"field": "gearbox_type", "source": "nrcan_fuel_ratings", "column": "transmission", "transform": "gearbox_type", "definition": "gearbox",
     "routes": ["european", "american", "unknown"], "min_level": "exact_technical_variant", "portability_scope": "exact_technical_variant"},
    {"field": "gear_count", "source": "nrcan_fuel_ratings", "column": "transmission", "transform": "gear_count", "definition": "gearbox",
     "routes": ["european", "american", "unknown"], "min_level": "exact_technical_variant", "portability_scope": "exact_technical_variant"},
    {"field": "length_mm", "source": "tc_cvs", "column": "length_cm", "unit": "cm", "scale": 10, "definition": "overall_length",
     "routes": ["american"], "min_level": "exact_technical_variant", "requires_corroboration": "wheelbase_mm",
     "portability_scope": "exact_technical_variant"},
    {"field": "width_mm", "source": "tc_cvs", "column": "width_cm", "unit": "cm", "scale": 10, "definition": "overall_width",
     "routes": ["american"], "min_level": "exact_technical_variant", "requires_corroboration": "wheelbase_mm",
     "portability_scope": "exact_technical_variant"},
    {"field": "height_mm", "source": "tc_cvs", "column": "height_cm", "unit": "cm", "scale": 10, "definition": "overall_height",
