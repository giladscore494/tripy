    {"field": "curb_weight_kg", "source": "eea_co2_cars", "column": "mass_running_order_kg", "unit": "kg", "definition": "eu_running_order",
     "routes": ["european"], "min_level": "exact_technical_variant", "portability_scope": "exact_technical_variant"},
    {"field": "curb_weight_kg", "source": "ademe_car_labelling", "column": "mass_running_order_kg", "unit": "kg", "definition": "eu_running_order",
     "routes": ["european"], "min_level": "exact_technical_variant", "portability_scope": "exact_technical_variant"},
    {"field": "curb_weight_kg", "source": "tc_cvs", "column": "curb_weight_kg", "unit": "kg", "definition": "na_curb",
     "routes": ["american"], "min_level": "exact_technical_variant", "portability_scope": "exact_technical_variant"},
    {"field": "fuel_consumption_combined_l_100km", "source": "eea_co2_cars", "column": "fuel_consumption_l_100km", "unit": "l/100km",
