{
  "_about": "Open structured data layer (src/open_data/). Per dataset: where it is downloaded from, the source column -> canonical key map (unit, definition tag, year semantics) and the local snapshot it becomes (<TRIPY_DATA_DIR>/derived/open/<dataset>.sqlite, one file per dataset, built by the background job). A column map entry lists the EXACT source spellings it accepts (`source`); the build reads the live header first and stops with a report when a mapped column is absent (or two spellings are present): it never guesses. `schema_verified` records whether the map was checked against the live schema; the build re-checks it every time either way. The engine reads only the local snapshots (vPIC: an on-demand decode, cached). `field_map`: the field offers a matched configuration makes, with the definition each source column measures and the route an offer may port to (D-4). Make aliases live in data/identity_vocabulary.json (`open_data_make_aliases`).",
  "version": "open-datasets-v1",
  "snapshot_subdir": "open",
  "refresh_interval_days": 30,
  "datasets": {
    "eea_co2_cars": {
      "policy_id": "eea_co2_cars", "market": "EU", "routes": ["european", "unknown"],
      "label": "EEA CO2 emissions from new passenger cars (monitoring)",
      "source_url": "https://discodata.eea.europa.eu/sql",
      "table": "[CO2Emission].[latest].[co2cars]", "years_from": 2017, "year_semantics": "registration_year",
      "registrations_column": {"source": ["r"], "key": "registrations"},
      "schema_verified": false,
      "columns": {
        "make": {"source": ["Mk"]},
        "model": {"source": ["Cn"]},
        "type_approval": {"source": ["T"]},
        "variant": {"source": ["Va"]},
        "version": {"source": ["Ve"]},
        "fuel": {"source": ["Ft"]},
        "fuel_mode": {"source": ["Fm"]},
        "displacement_cc": {"source": ["ec (cm3)", "ec"], "unit": "cc"},
        "power_kw": {"source": ["ep (KW)", "ep"], "unit": "kW"},
        "co2_wltp": {"source": ["Ewltp (g/km)", "Ewltp"], "unit": "g/km"},
        "co2_nedc": {"source": ["Enedc (g/km)", "Enedc"], "unit": "g/km"},
        "wheelbase_mm": {"source": ["W (mm)", "W"], "unit": "mm"},
        "track_front_mm": {"source": ["At1 (mm)", "At1"], "unit": "mm"},
        "track_rear_mm": {"source": ["At2 (mm)", "At2"], "unit": "mm"},
        "mass_running_order_kg": {"source": ["m (kg)", "m"], "unit": "kg", "definition": "eu_running_order"},
        "mass_wltp_test_kg": {"source": ["Mt"], "unit": "kg", "definition": "eu_wltp_test_mass"},
        "energy_wh_km": {"source": ["z (Wh/km)", "z"], "unit": "Wh/km"},
        "electric_range_km": {"source": ["Electric range (km)", "Electric range"], "unit": "km"},
        "fuel_consumption_l_100km": {"source": ["Fuel consumption ", "Fuel consumption"], "unit": "l/100km"},
        "year": {"source": ["year"]}
      }
    },
    "ademe_car_labelling": {
      "policy_id": "ademe_car_labelling", "market": "FR", "routes": ["european", "unknown"],
      "label": "ADEME Car Labelling",
      "source_url": "https://www.data.gouv.fr/fr/datasets/ademe-car-labelling/",
      "year_semantics": "dataset_date",
      "schema_verified": false,
      "lexicon_note": "The ADEME lexicon was not readable from the build host of this PR: the map below lists the spellings expected from it; the build stops and reports any column it does not find.",
      "columns": {
        "make": {"source": ["Marque"]},
        "model": {"source": ["Modèle dossier", "Modele dossier"]},
        "version": {"source": ["Désignation commerciale", "Designation commerciale"]},
        "fuel": {"source": ["Energie", "Énergie"]},
        "power_kw": {"source": ["Puissance maximale"], "unit": "kW"},
        "fiscal_power": {"source": ["Puissance administrative"]},
        "gearbox": {"source": ["Type de boîte", "Type de boite"]},
        "mass_running_order_kg": {"source": ["Masse vide euro min", "Masse en ordre de marche"], "unit": "kg",
                                  "definition": "eu_running_order"},
        "co2_wltp": {"source": ["CO2 vitesse mixte Min", "Emission CO2 WLTP"], "unit": "g/km"},
        "fuel_consumption_l_100km": {"source": ["Conso vitesse mixte Min", "Consommation mixte WLTP"], "unit": "l/100km"},
        "energy_wh_km": {"source": ["Conso elec Min", "Consommation électrique WLTP"], "unit": "Wh/km"},
        "electric_range_km": {"source": ["Autonomie elec Min", "Autonomie électrique WLTP"], "unit": "km"},
        "date": {"source": ["Date de mise à jour", "Date de mise a jour"]}
      }
    },
    "epa_fueleconomy": {
